# ============================================================
# 线索收集表单配置（三选一，留空则自动降级为「复制发微信」模式）
# ============================================================

# 【推荐 · 最省事】群机器人 / Webhook 地址
# 填一个能接收 JSON POST 的 URL，表单新线索会实时推送到群里。
#
# 飞书群机器人：
#   飞书群 → 设置 → 群机器人 → 添加机器人 → 自定义机器人 → 复制 Webhook 地址
#   形如 https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
#
# 企业微信群机器人：
#   企业微信群 → 右上角 → 群机器人 → 添加 → 复制 Webhook
#   形如 https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxx
#
# Formspree（有后台列表，免费 50 条/月）：https://formspree.io
#   形如 https://formspree.io/f/xxxxxxx
NEXT_PUBLIC_LEAD_WEBHOOK=

# 【备用】Supabase（需先关闭 leads 表 RLS，并 GRANT anon insert）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
# 站点配置
# ============================================================

# 站点规范域名（用于 canonical / sitemap / 结构化数据），不带结尾斜杠
NEXT_PUBLIC_SITE_URL=https://www.zhuanshi365.cn

# 手动复制模式展示的微信号（留空则只提示「发送给备考助手」）
NEXT_PUBLIC_WECHAT_ID=
